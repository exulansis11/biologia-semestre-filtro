{
  "name": "biologia-semestre-filtro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,css}\" scripts index.html vite.config.ts",
    "test": "node scripts/verificar-interface.mjs",
    "icons": "node scripts/gerar-icones.mjs",
    "imagens": "node scripts/baixar-imagens.mjs",
    "mesclar": "node scripts/mesclar-ampliacao.mjs",
    "publicar": "bash scripts/publicar.sh"
  },
  "dependencies": {
    "@react-three/drei": "9.117.3",
    "@react-three/fiber": "8.17.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "vite": "6.0.3",
    "vite-plugin-pwa": "0.21.1",
    "esbuild": "0.24.2"
  }
}
